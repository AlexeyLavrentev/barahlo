# Локальная разработка (значения по умолчанию).
# НА СЕРВЕРЕ (docker compose, см. README «Деплой на сервер») впишите прод-пути:
#   DATABASE_PATH=/app/data/app.db
#   DATA_DIR=/app/data
# AUTH_SECRET обязателен и должен быть не короче 32 символов: без него вход в
# приложение работать не будет (первая же попытка логина упадёт с ошибкой).
# Сгенерируйте: openssl rand -base64 32
DATABASE_PATH=./data/app.db
DATA_DIR=./data
AUTH_SECRET=
